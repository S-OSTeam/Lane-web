{
  "compilerOptions": {
    "target": "ES2017",
    "@lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@auth/*": ["../auth/app/*"],
      "@clip/*": ["../clip/app/*"],
      "@community/*": ["../community/app/*"],
      "@home/*": ["../home/app/*"],
      "@management/*": ["../management/app/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "../../packages/hooks/tsconfig.json"]
}
